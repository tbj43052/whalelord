# copy to .env and edit
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/whalelord

# Signs session tickets. Long random string, never shipped to the browser. (e.g. `openssl rand -hex 32`)
SERVER_SECRET=change-me-to-a-long-random-string

# Must equal CLIENT_SALT at the top of ../game.js. Obscurity only — see README "Integrity model".
CLIENT_SALT=whalelord-frenzy-v1

# Only needed if the site is hosted on a different origin than this API (comma-separated list).
ALLOWED_ORIGIN=
